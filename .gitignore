# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw local source photos used to seed medicine images (unprocessed, includes
# rejected/watermarked candidates) — the standardized output actually used by
# the app lives in scripts/seed/assets/real/ and Supabase Storage instead
Medicine\ Image\ /

# raw local source logos used to seed pharmacy brand images (unprocessed);
# the standardized output used by the app lives in scripts/seed/assets/brand/
# and Supabase Storage instead
Brand\ image\ /

# tesseract.js language data, fetched at runtime from the CDN in the browser;
# a Node run drops a 5MB copy in the project root
*.traineddata

# Regenerated on every discovery run (timestamped) — the evidence record is pilot-results.json
scripts/urls/results/work-queue.json
